+
+func validTraceText(value string, limit int) bool {
+	if strings.TrimSpace(value) == "" || len(value) > limit || !utf8.ValidString(value) || strings.ContainsRune(value, 0) {
+		return false
+	}
+	for _, r := range value {
+		if unicode.IsControl(r) && r != '\n' && r != '\r' && r != '\t' {
+			return false
+		}
+	}
+	return true
+}
