+	 id INTEGER PRIMARY KEY CHECK(id=1), evidence_hash TEXT NOT NULL DEFAULT '', synthesis TEXT NOT NULL DEFAULT '',
+	 notice TEXT NOT NULL DEFAULT '', created_at TEXT NOT NULL DEFAULT '', updated_at TEXT NOT NULL DEFAULT '')`); err != nil {
+		return err
+	}
+	_, err := db.Exec(`CREATE TABLE IF NOT EXISTS career_connection_challenges (
+	 synthesis_hash TEXT NOT NULL, connection_id TEXT NOT NULL, state TEXT NOT NULL DEFAULT '',
+	 note TEXT NOT NULL DEFAULT '', updated_at TEXT NOT NULL DEFAULT '', PRIMARY KEY(synthesis_hash, connection_id))`)
+	return err
+}
+
+// discoveryDestination names the actual inference destination before the
+// candidate authorizes a request. HACK-BASETEN: Baseten is disclosed when
+// selected; unset preserves the Meta destination.
+func discoveryDestination() string {
+	backend, err := coverprovider.SelectedMuseBackend()
+	if err == nil && backend == coverprovider.MuseBackendBaseten {
+		return "Baseten (temporary hackathon backend, meta-models/muse-spark-open-1026)"
+	}
+	return "Meta (muse-spark-1.3, standard mode)"
+}
+
+type connectionView struct {
+	discovery.Connection
+	Challenge string
+	Note      string
+	Stale     bool // a supporting record changed revision since synthesis
+}
+
+type studioPage struct {
+	Evidences   []CareerEvidence
+	Drafts      []CareerEvidence
+	Connections []connectionView
+	Synthesis   *discovery.ConnectionSynthesis
+	Hash        string
+	StoredHash  string
+	Stale       bool
+	Notice      string
+	Destination string
+	Roles       []roleAnalysisPage
+	ChallengeN  int
+}
+
+func reviewedSynthesisEvidences(a *App) ([]CareerEvidence, []discovery.ConnectionEvidence, error) {
+	reviewed, err := reviewedRoleEvidencesAll(a)
+	if err != nil {
+		return nil, nil, err
+	}
+	inputs := make([]discovery.ConnectionEvidence, 0, len(reviewed))
+	for _, e := range reviewed {
+		in := discovery.ConnectionEvidence{ID: e.ID, Revision: e.Revision, Title: e.Title, Situation: e.Situation, Actions: e.Actions, OutcomeState: e.OutcomeState}
+		if sources, err := a.careerEvidenceTraceSources(e); err == nil {
+			for _, s := range sources {
+				in.SourceTexts = append(in.SourceTexts, s.ResponseText)
+			}
+		}
+		inputs = append(inputs, in)
+	}
+	return reviewed, inputs, nil
+}
+
+// reviewedRoleEvidencesAll is reviewedRoleEvidences without the role cap:
+// synthesis accepts up to MaxConnectionEvidences records.
+func reviewedRoleEvidencesAll(a *App) ([]CareerEvidence, error) {
+	entries, err := a.careerEvidenceEntries()
+	if err != nil {
+		return nil, err
+	}
+	var out []CareerEvidence
+	for _, e := range entries {
+		if e.Status != "reviewed" || strings.TrimSpace(e.Title) == "" || strings.TrimSpace(e.Situation) == "" || strings.TrimSpace(e.Actions) == "" {
+			continue
+		}
+		out = append(out, e)
+		if len(out) >= discovery.MaxConnectionEvidences {
+			break
+		}
+	}
+	return out, nil
+}
+
+func (p studioPage) EvidenceTitle(id int64) string {
+	for _, e := range p.Evidences {
+		if e.ID == id {
+			return e.Title
+		}
+	}
+	return "Record (no longer reviewed or present)"
+}
+
+func (a *App) loadStudio() (studioPage, error) {
+	page := studioPage{Destination: discoveryDestination()}
+	entries, err := a.careerEvidenceEntries()
+	if err != nil {
+		return page, err
+	}
+	for _, e := range entries {
+		if e.Status == "reviewed" {
+			page.Evidences = append(page.Evidences, e)
+		} else {
+			page.Drafts = append(page.Drafts, e)
+		}
+	}
+	reviewed, _, err := reviewedSynthesisEvidences(a)
+	if err != nil {
+		return page, err
+	}
+	page.Hash = roleEvidenceHash(reviewed)
+	var raw, notice string
+	err = a.db.QueryRow(`SELECT evidence_hash,synthesis,notice FROM career_connections WHERE id=1`).Scan(&page.StoredHash, &raw, &notice)
+	if err == nil && raw != "" {
+		var syn discovery.ConnectionSynthesis
+		if json.Unmarshal([]byte(raw), &syn) == nil {
+			page.Synthesis = &syn
+			page.Notice = notice
+			page.Stale = page.StoredHash != page.Hash
+			current := map[int64]int64{}
+			for _, e := range reviewed {
+				current[e.ID] = e.Revision
+			}
+			challenges := map[string][2]string{}
+			rows, qerr := a.db.Query(`SELECT connection_id,state,note FROM career_connection_challenges WHERE synthesis_hash=?`, page.StoredHash)
+			if qerr == nil {
+				defer rows.Close()
+				for rows.Next() {
+					var id, state, note string
+					if rows.Scan(&id, &state, &note) == nil {
+						challenges[id] = [2]string{state, note}
+					}
+				}
+			}
+			for _, c := range syn.Connections {
+				v := connectionView{Connection: c}
+				if ch, ok := challenges[c.ID]; ok {
+					v.Challenge, v.Note = ch[0], ch[1]
+					if v.Challenge != "" {
+						page.ChallengeN++
+					}
+				}
+				for _, s := range c.Supports {
+					if rev, ok := current[s.EvidenceID]; !ok || rev != s.EvidenceRevision {
+						v.Stale = true
+					}
+				}
+				page.Connections = append(page.Connections, v)
+			}
+		}
+	} else if err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return page, err
+	}
+	// Role summaries reuse the saved HACK-005 analyses; no new inference here.
+	hash := roleEvidenceHash(mustCap(reviewed))
+	for _, role := range careerRoleProfiles() {
+		entry := roleAnalysisPage{Role: role, Hash: hash}
+		var araw, anotice string
+		if err := a.db.QueryRow(`SELECT analysis,notice FROM career_role_analyses WHERE role_key=? AND evidence_hash=?`, role.Key, hash).Scan(&araw, &anotice); err == nil && araw != "" {
+			var analysis discovery.RoleAnalysis
+			if json.Unmarshal([]byte(araw), &analysis) == nil && analysis.RoleKey == role.Key {
+				entry.Analysis = &analysis
+				entry.Notice = anotice
+			}
+		}
+		if job, err := a.roleOpportunity(role.Key); err == nil && job != nil {
+			entry.Job = job
+			entry.Flags = a.savedAnswerProvenance(*job)
+		}
+		page.Roles = append(page.Roles, entry)
+	}
+	return page, nil
+}
+
+func mustCap(e []CareerEvidence) []CareerEvidence {
+	if len(e) > discovery.MaxRoleEvidences {
+		return e[:discovery.MaxRoleEvidences]
+	}
+	return e
+}
+
+func (a *App) careerStudioPage(w http.ResponseWriter, r *http.Request) {
+	page, err := a.loadStudio()
+	if err != nil {
+		http.Error(w, "Unable to load Career Studio", 500)
+		return
+	}
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	w.Header().Set("Cache-Control", "private, no-store")
+	_ = a.resources.careerStudioTemplate.Execute(w, page)
+}
+
+func (a *App) runSynthesis(ctx context.Context, evidences []CareerEvidence, inputs []discovery.ConnectionEvidence) error {
+	generate, metrics, err := a.discoveryRunner()
+	var syn discovery.ConnectionSynthesis
+	if err == nil {
+		syn, err = discovery.SynthesizeConnections(ctx, generate, inputs)
+	}
+	hash := roleEvidenceHash(evidences)
+	notice := fmt.Sprintf("Muse compared %d reviewed experience(s) together. These connections are hypotheses for your judgment; nothing was approved or adopted.", len(evidences))
+	if err != nil {
+		notice = "Muse could not complete this synthesis (" + coverprovider.ErrorNotice(err) + "). No interpretation was saved."
+		if errors.Is(err, discovery.ErrInvalid) {
+			notice = "Muse output did not pass source or format checks. Nothing was saved; retry the synthesis."
+		}
+	}
+	notice += discoveryUsageNote(*metrics, true)
+	now := time.Now().UTC().Format(time.RFC3339Nano)
+	if err != nil {
+		_, dbErr := a.db.Exec(`INSERT INTO career_connections(id,evidence_hash,synthesis,notice,created_at,updated_at) VALUES(1,?,'',?,?,?) ON CONFLICT(id) DO UPDATE SET notice=excluded.notice,updated_at=excluded.updated_at`, hash, notice, now, now)
+		return dbErr
+	}
+	raw, _ := json.Marshal(syn)
+	_, dbErr := a.db.Exec(`INSERT INTO career_connections(id,evidence_hash,synthesis,notice,created_at,updated_at) VALUES(1,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET evidence_hash=excluded.evidence_hash,synthesis=excluded.synthesis,notice=excluded.notice,updated_at=excluded.updated_at`, hash, string(raw), notice, now, now)
+	return dbErr
+}
+
+func (a *App) synthesizeConnections(w http.ResponseWriter, r *http.Request) {
+	if !discoveryConsent(w, r) {
+		return
+	}
+	if !a.discoveryMu.TryLock() {
+		http.Error(w, "A Muse request is already in progress. Wait before retrying.", http.StatusConflict)
+		return
+	}
+	defer a.discoveryMu.Unlock()
+	evidences, inputs, err := reviewedSynthesisEvidences(a)
+	if err != nil || len(evidences) < 2 {
+		http.Error(w, "Review at least two Career Evidence records before looking for connections.", 422)
+		return
+	}
+	if err := a.runSynthesis(r.Context(), evidences, inputs); err != nil {
+		http.Error(w, "Unable to save synthesis", 500)
+		return
+	}
+	http.Redirect(w, r, "/career-studio#connections", http.StatusSeeOther)
+}
+
+// challengeConnection records the candidate's judgment. It never edits
+// evidence, never deletes the interpretation, and survives restart.
+func (a *App) challengeConnection(w http.ResponseWriter, r *http.Request) {
+	if !parseLocalForm(w, r, 8<<10) {
+		return
+	}
+	connID := r.PathValue("id")
+	if connID != "conn-1" && connID != "conn-2" && connID != "conn-3" {
+		http.NotFound(w, r)
+		return
+	}
+	state := r.PostForm.Get("state")
+	if state != "" && state != "questioned" && state != "unsupported" {
+		http.Error(w, "Choose a challenge state", 400)
+		return
+	}
+	note := strings.TrimSpace(r.PostForm.Get("note"))
+	if len(note) > 500 {
+		http.Error(w, "Keep the note under 500 bytes", 400)
+		return
+	}
+	var hash string
+	if err := a.db.QueryRow(`SELECT evidence_hash FROM career_connections WHERE id=1`).Scan(&hash); err != nil || hash == "" {
+		http.Error(w, "No saved synthesis to challenge", 409)
+		return
+	}
+	now := time.Now().UTC().Format(time.RFC3339Nano)
+	if _, err := a.db.Exec(`INSERT INTO career_connection_challenges(synthesis_hash,connection_id,state,note,updated_at) VALUES(?,?,?,?,?) ON CONFLICT(synthesis_hash,connection_id) DO UPDATE SET state=excluded.state,note=excluded.note,updated_at=excluded.updated_at`, hash, connID, state, note, now); err != nil {
+		http.Error(w, "Unable to save challenge", 500)
+		return
+	}
+	http.Redirect(w, r, "/career-studio#connections", http.StatusSeeOther)
+}
diff --git a/internal/app/career_connections_test.go b/internal/app/career_connections_test.go
new file mode 100644
index 0000000..b627cdc
--- /dev/null
+++ b/internal/app/career_connections_test.go
@@ -0,0 +1,100 @@
+package app
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/jenksed/yourmove-go/internal/storage"
+)
+
+func seedSecondReviewed(t *testing.T, a *App) {
+	t.Helper()
+	now := "2026-10-26T10:00:00Z"
+	if _, err := a.db.Exec(`INSERT INTO career_evidence(title,situation,actions,outcome_state,source_notes,source_writing,status,revision,created_at,updated_at) VALUES('Billing escalation','Customer could not access invoices after a plan change','Explained the billing cause to the customer and coordinated a technical handoff to billing engineering; did not own the account.','unknown','synthetic','synthetic','reviewed',1,?,?)`, now, now); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func connGenerate(_ context.Context, _, _ string) (string, error) {
+	return `{"connections":[{"id":"conn-1","capability":"Cross-functional technical problem-solving","interpretation":"Both records show diagnosis followed by a documented handoff.","relationship":"Diagnosis plus handoff recurs across database and billing contexts.","supports":[{"evidence_id":1,"evidence_revision":2,"quote":"Checked slow query log and used EXPLAIN","action":"Diagnosed the slow query"},{"evidence_id":2,"evidence_revision":1,"quote":"coordinated a technical handoff to billing engineering","action":"Coordinated the handoff"}],"limitations":["Production change ownership stayed with other teams","Renewal ownership is not established"],"candidate_use":"I can credibly say I diagnose problems and move them across team boundaries with documented handoffs","follow_up":"Did recipients confirm your findings were acted on?"}]}`, nil
+}
+
+func TestStudioSynthesisChallengeStaleAndRestart(t *testing.T) {
+	a, dir := testWorkspace(t)
+	seedReviewedEvidence(t, a)
+	seedSecondReviewed(t, a)
+	a.discoveryGenerate = connGenerate
+	mux := newMux(a)
+
+	if got := postCareerEvidence(mux, "/career-connections/synthesize", url.Values{"consent": {"yes"}}); got.Code != 303 {
+		t.Fatal("synthesize", got.Code, got.Body.String())
+	}
+	get := func(path string) string {
+		rec := httptest.NewRecorder()
+		mux.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "http://localhost"+path, nil))
+		if rec.Code != 200 {
+			t.Fatal(path, rec.Code, rec.Body.String()[:400])
+		}
+		return rec.Body.String()
+	}
+	body := get("/career-studio")
+	for _, want := range []string{"Cross-functional technical problem-solving", "Checked slow query log and used EXPLAIN", "What this does not establish", "AI hypothesis", "Challenge this interpretation"} {
+		if !strings.Contains(body, want) {
+			t.Fatal("studio missing", want)
+		}
+	}
+	// Challenge persists.
+	if got := postCareerEvidence(mux, "/career-connections/conn-1/challenge", url.Values{"state": {"unsupported"}, "note": {"That was mostly the DBA"}}); got.Code != 303 {
+		t.Fatal("challenge", got.Code, got.Body.String())
+	}
+	if body = get("/career-studio"); !strings.Contains(body, "marked this interpretation") || !strings.Contains(body, "unsupported") {
+		t.Fatal("challenge not shown", body[:600])
+	}
+	// Correction (new revision) marks dependent interpretation stale; evidence itself untouched by challenge.
+	if _, err := a.db.Exec(`UPDATE career_evidence SET actions='Checked slow query log; suggested an index.',revision=3 WHERE id=1`); err != nil {
+		t.Fatal(err)
+	}
+	if body = get("/career-studio"); !strings.Contains(body, "Supporting evidence changed") {
+		t.Fatal("stale state not shown after correction")
+	}
+	// Synthesis requires consent naming the actual destination.
+	if got := postCareerEvidence(mux, "/career-connections/synthesize", url.Values{}); got.Code != 400 || !strings.Contains(got.Body.String(), "Authorize sending this to Meta") {
+		t.Fatal("consent gate", got.Code, got.Body.String())
+	}
+	// Restart: synthesis + challenge survive in SQLite.
+	if err := a.db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	db, err := storage.OpenDB(filepath.Join(dir, "jobs.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	var syn, state string
+	if err := db.QueryRow(`SELECT synthesis FROM career_connections WHERE id=1`).Scan(&syn); err != nil || !strings.Contains(syn, "Cross-functional") {
+		t.Fatal("synthesis did not survive restart", err)
+	}
+	if err := db.QueryRow(`SELECT state FROM career_connection_challenges WHERE connection_id='conn-1'`).Scan(&state); err != nil || state != "unsupported" {
+		t.Fatal("challenge did not survive restart", state, err)
+	}
+}
+
+func TestStudioRequiresTwoReviewed(t *testing.T) {
+	a, _ := testWorkspace(t)
+	seedReviewedEvidence(t, a)
+	a.discoveryGenerate = connGenerate
+	mux := newMux(a)
+	if got := postCareerEvidence(mux, "/career-connections/synthesize", url.Values{"consent": {"yes"}}); got.Code != 422 {
+		t.Fatal("expected 422 with one reviewed record", got.Code)
+	}
+	rec := httptest.NewRecorder()
+	mux.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "http://localhost/career-studio", nil))
+	if rec.Code != 200 || !strings.Contains(rec.Body.String(), "at least two reviewed") {
+		t.Fatal("studio gate", rec.Code)
+	}
+}
diff --git a/internal/app/career_discovery.go b/internal/app/career_discovery.go
new file mode 100644
index 0000000..45eb2b0
--- /dev/null
+++ b/internal/app/career_discovery.go
@@ -0,0 +1,529 @@
+package app
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	discovery "github.com/jenksed/yourmove-career-discovery"
+	coverprovider "github.com/jenksed/yourmove-go/internal/coverletter/provider"
+)
+
+// Only interview state is new storage; approved evidence stays in career_evidence.
+func initializeDiscovery(db *sql.DB) error {
+	_, err := db.Exec(`CREATE TABLE IF NOT EXISTS career_discovery (
+	 id INTEGER PRIMARY KEY, revision INTEGER NOT NULL DEFAULT 1,
+	 state TEXT NOT NULL, evidence_id INTEGER NOT NULL DEFAULT 0,
+	 notice TEXT NOT NULL DEFAULT '', created_at TEXT NOT NULL)`)
+	return err
+}
+
+type discoveryPage struct {
+	ID, Revision, EvidenceID int64
+	State                    discovery.State
+	Notice                   string
+	CanAnswer                bool
+	Sessions                 []discoverySessionLink
+	Destination              string
+}
+type discoverySessionLink struct {
+	ID        int64
+	CreatedAt string
+}
+
+func (p discoveryPage) NeedsLeads() bool {
+	return p.ID != 0 && p.EvidenceID == 0 && len(p.State.Leads) == 0 && len(p.State.Responses) == 0 && p.State.Question == ""
+}
+func (p discoveryPage) LeadPicker() bool {
+	return len(p.State.Leads) > 0 && p.State.SelectedLeadID == "" && len(p.State.Responses) == 0
+}
+
+func (a *App) discoveryByID(id int64) (discoveryPage, error) {
+	var p discoveryPage
+	var raw string
+	p.ID = id
+	err := a.db.QueryRow(`SELECT revision,state,evidence_id,notice FROM career_discovery WHERE id=?`, id).Scan(&p.Revision, &raw, &p.EvidenceID, &p.Notice)
+	if err != nil {
+		return p, err
+	}
+	if json.Unmarshal([]byte(raw), &p.State) != nil {
+		return p, discovery.ErrInvalid
+	}
+	p.CanAnswer = p.EvidenceID == 0 && p.State.Question != "" && len(p.State.Responses) < discovery.MaxResponses
+	return p, nil
+}
+
+// careerEvidenceTraceSources rebinds interview responses to the exact reviewed
+// record revision. A record without a discovery row remains usable for ordinary
+// answer drafting, but cannot advertise an interview Evidence Trace.
+func (a *App) careerEvidenceTraceSources(e CareerEvidence) ([]discovery.TraceSource, error) {
+	var raw string
+	err := a.db.QueryRow(`SELECT state FROM career_discovery WHERE evidence_id=?`, e.ID).Scan(&raw)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var state discovery.State
+	if json.Unmarshal([]byte(raw), &state) != nil || state.Proposal == nil || state.ValidateProposal() != nil || e.SourceWriting != state.Transcript() || len(state.Responses) == 0 {
+		return nil, discovery.ErrInvalid
+	}
+	sources := make([]discovery.TraceSource, 0, len(state.Responses))
+	for i, response := range state.Responses {
+		if response.Source.ID != fmt.Sprintf("response-%d", i+1) || response.Source.Kind != "self_report" || !validNarrativeText(response.Question) || !validNarrativeText(response.Source.Text) || len(response.Source.Text) > 2000 {
+			return nil, discovery.ErrInvalid
+		}
+		sources = append(sources, discovery.TraceSource{EvidenceID: e.ID, EvidenceRevision: e.Revision, ResponseID: response.Source.ID, ResponseText: response.Source.Text})
+	}
+	return sources, nil
+}
+
+func (a *App) careerDiscoveryPage(w http.ResponseWriter, r *http.Request) {
+	var p discoveryPage
+	if raw := r.PathValue("id"); raw != "" {
+		id, err := strconv.ParseInt(raw, 10, 64)
+		if err != nil || id < 1 {
+			http.NotFound(w, r)
+			return
+		}
+		p, err = a.discoveryByID(id)
+		if errors.Is(err, sql.ErrNoRows) {
+			http.NotFound(w, r)
+			return
+		}
+		if err != nil {
+			http.Error(w, "Unable to load interview", 500)
+			return
+		}
+	} else {
+		rows, err := a.db.Query(`SELECT id,created_at FROM career_discovery ORDER BY id DESC LIMIT 20`)
+		if err != nil {
+			http.Error(w, "Unable to load interviews", 500)
+			return
+		}
+		defer rows.Close()
+		for rows.Next() {
+			var link discoverySessionLink
+			if err := rows.Scan(&link.ID, &link.CreatedAt); err != nil {
+				http.Error(w, "Unable to load interviews", 500)
+				return
+			}
+			p.Sessions = append(p.Sessions, link)
+		}
+		if rows.Err() != nil {
+			http.Error(w, "Unable to load interviews", 500)
+			return
+		}
+	}
+	p.Destination = discoveryDestination()
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	w.Header().Set("Cache-Control", "private, no-store")
+	_ = a.resources.careerDiscoveryTemplate.Execute(w, p)
+}
+
+func discoveryConsent(w http.ResponseWriter, r *http.Request) bool {
+	if !parseLocalForm(w, r, 64<<10) {
+		return false
+	}
+	if len(r.PostForm["consent"]) != 1 || r.PostForm.Get("consent") != "yes" {
+		http.Error(w, "Authorize sending this to "+discoveryDestination()+" before continuing", 400)
+		return false
+	}
+	return true
+}
+
+func (a *App) startCareerDiscovery(w http.ResponseWriter, r *http.Request) {
+	if !discoveryConsent(w, r) {
+		return
+	}
+	if !a.discoveryMu.TryLock() {
+		http.Error(w, "A Muse interview request is already in progress. Wait before retrying.", http.StatusConflict)
+		return
+	}
+	defer a.discoveryMu.Unlock()
+	if len(r.PostForm["resume"]) != 1 {
+		http.Error(w, "Provide one resume excerpt", 400)
+		return
+	}
+	s, err := discovery.New(r.PostForm.Get("resume"))
+	if err != nil {
+		http.Error(w, "Use a resume excerpt of 1–8000 bytes", 422)
+		return
+	}
+	raw, _ := json.Marshal(s)
+	result, err := a.db.Exec(`INSERT INTO career_discovery(state,created_at) VALUES(?,?)`, string(raw), time.Now().UTC().Format(time.RFC3339Nano))
+	if err != nil {
+		http.Error(w, "Unable to save interview", 500)
+		return
+	}
+	id, err := result.LastInsertId()
+	if err != nil {
+		http.Error(w, "Unable to locate saved interview", 500)
+		return
+	}
+	p := discoveryPage{ID: id, Revision: 1, State: s}
+	if err := a.runLeads(r.Context(), p); err != nil {
+		http.Error(w, fmt.Sprintf("Interview input saved, but the model result could not be saved. Return to /career-discovery/%d to recover it.", id), 500)
+		return
+	}
+	http.Redirect(w, r, fmt.Sprintf("/career-discovery/%d", id), http.StatusSeeOther)
+}
+
+func (a *App) discoveryRunner() (discovery.Generate, *coverprovider.RequestMetrics, error) {
+	if a.discoveryGenerate != nil {
+		return a.discoveryGenerate, &coverprovider.RequestMetrics{}, nil
+	}
+	runner, err := coverprovider.ConfigureMeta()
+	if err != nil {
+		return nil, &coverprovider.RequestMetrics{}, err
+	}
+	metrics := &coverprovider.RequestMetrics{}
+	gen := func(ctx context.Context, prompt, instructions string) (string, error) {
+		return runner.GenerateDiscovery(ctx, prompt, instructions, func(m coverprovider.RequestMetrics) { *metrics = m })
+	}
+	return gen, metrics, nil
+}
+
+// discoveryUsageNote reports observed inference usage with the actual backend
+// and model identity, so diagnostics and evaluation results preserve which
+// model ran. Meta dollar estimates never apply to Baseten usage, which bills
+// the hackathon account separately.
+func discoveryUsageNote(m coverprovider.RequestMetrics, withFinish bool) string {
+	if m.PromptTokens <= 0 && m.CompletionTokens <= 0 {
+		return ""
+	}
+	// HACK-BASETEN: temporary backend branch; delete on removal.
+	if m.Backend == coverprovider.MuseBackendBaseten {
+		note := fmt.Sprintf(" Tokens: %d input / %d output via Baseten %s", m.PromptTokens, m.CompletionTokens, m.Model)
+		if withFinish {
+			note += fmt.Sprintf("; finish: %s", m.FinishReason)
+		}
+		return note + "."
+	}
+	// Standard-mode estimate, not an account charge; rates checked 2026-10-26.
+	cached := min(m.CachedTokens, m.PromptTokens)
+	cost := (float64(m.PromptTokens-cached)*1.25 + float64(cached)*0.15 + float64(m.CompletionTokens)*4.25) / 1e6
+	note := fmt.Sprintf(" Tokens: %d input / %d output; estimated inference $%.5f", m.PromptTokens, m.CompletionTokens, cost)
+	if withFinish {
+		note += fmt.Sprintf("; finish: %s", m.FinishReason)
+	}
+	return note + "."
+}
+
+func (a *App) runLeads(ctx context.Context, p discoveryPage) error {
+	generate, metrics, err := a.discoveryRunner()
+	next := p.State
+	if err == nil {
+		var leads []discovery.Lead
+		leads, err = discovery.FindLeads(ctx, generate, p.State.Resume.Text)
+		if err == nil {
+			next.Leads = leads
+		}
+	}
+	notice := "Muse identified investigation leads. Choose one to explore, or start a new excerpt."
+	if err != nil {
+		notice = "Muse could not identify leads (" + coverprovider.ErrorNotice(err) + "). Your excerpt is saved; retry below. Nothing was approved."
+		if errors.Is(err, discovery.ErrInvalid) {
+			notice = "Muse output did not pass lead checks. Your excerpt is saved; retry below. Nothing was approved."
+		}
+	}
+	notice += discoveryUsageNote(*metrics, false)
+	raw, _ := json.Marshal(next)
+	result, err := a.db.Exec(`UPDATE career_discovery SET state=?,notice=?,revision=revision+1 WHERE id=? AND revision=? AND evidence_id=0`, string(raw), notice, p.ID, p.Revision)
+	if err != nil {
+		return err
+	}
+	n, _ := result.RowsAffected()
+	if n != 1 {
+		return ErrCareerEvidenceStale
+	}
+	return nil
+}
+
+func (a *App) retryCareerLeads(w http.ResponseWriter, r *http.Request) {
+	if !discoveryConsent(w, r) {
+		return
+	}
+	if !a.discoveryMu.TryLock() {
+		http.Error(w, "A Muse interview request is already in progress. Wait before retrying.", http.StatusConflict)
+		return
+	}
+	defer a.discoveryMu.Unlock()
+	id, _ := strconv.ParseInt(r.PathValue("id"), 10, 64)
+	p, err := a.discoveryByID(id)
+	if err != nil {
+		http.NotFound(w, r)
+		return
+	}
+	revision, err := parseCareerEvidenceRevision(r)
+	if err != nil || revision != p.Revision || p.EvidenceID != 0 || len(p.State.Leads) > 0 {
+		http.Error(w, "Interview changed. Reload before continuing.", 409)
+		return
+	}
+	if err := a.runLeads(r.Context(), p); err != nil {
+		http.Error(w, "Unable to save leads.", 500)
+		return
+	}
+	http.Redirect(w, r, fmt.Sprintf("/career-discovery/%d", id), http.StatusSeeOther)
+}
+
+func (a *App) selectCareerLead(w http.ResponseWriter, r *http.Request) {
+	if !discoveryConsent(w, r) {
+		return
+	}
+	if !a.discoveryMu.TryLock() {
+		http.Error(w, "A Muse interview request is already in progress. Wait before retrying.", http.StatusConflict)
+		return
+	}
+	defer a.discoveryMu.Unlock()
+	id, _ := strconv.ParseInt(r.PathValue("id"), 10, 64)
+	p, err := a.discoveryByID(id)
+	if err != nil {
+		http.NotFound(w, r)
+		return
+	}
+	revision, err := parseCareerEvidenceRevision(r)
+	if err != nil || revision != p.Revision || p.EvidenceID != 0 {
+		http.Error(w, "Interview changed. Reload before continuing.", 409)
+		return
+	}
+	p.State, err = discovery.SelectLead(p.State, r.PostForm.Get("lead_id"))
+	if err != nil {
+		http.Error(w, "Choose a listed lead before responses begin.", 422)
+		return
+	}
+	raw, _ := json.Marshal(p.State)
+	result, err := a.db.Exec(`UPDATE career_discovery SET state=?,notice='Request in progress. If interrupted, retry from this page.',revision=revision+1 WHERE id=? AND revision=? AND evidence_id=0`, string(raw), id, p.Revision)
+	if err != nil {
+		http.Error(w, "Unable to save selection", 500)
+		return
+	}
+	if n, _ := result.RowsAffected(); n != 1 {
+		http.Error(w, "Interview changed. Reload before continuing.", 409)
+		return
+	}
+	p.Revision++
+	if err := a.runDiscovery(r.Context(), p); err != nil {
+		http.Error(w, "Your selection is saved, but the model result could not be saved. Reload the interview.", 500)
+		return
+	}
+	http.Redirect(w, r, fmt.Sprintf("/career-discovery/%d", id), http.StatusSeeOther)
+}
