+<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Career Discovery · YourMove</title><link rel="stylesheet" href="/static/styles.css"><script defer src="/static/ui.js"></script></head><body>
+{{template "shell-open" "career-evidence"}}
+<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/career-evidence">Career Evidence</a><span aria-hidden="true">/</span><span>Career Discovery</span></nav>
+<div class="page-heading"><div><h1>Career Discovery</h1><p class="page-description">An investigation into your own experience. Muse asks, you answer, and nothing represents you until you approve it.</p></div></div>
+{{if .ID}}
+{{if .Notice}}<p class="local-save-confirmation" role="status">{{.Notice}}</p>{{end}}
+<div class="investigator">
+  <div class="investigator-main">
+  {{if .EvidenceID}}
+    <section aria-labelledby="story-ready"><h2 id="story-ready">Your evidence draft is ready for review</h2><p class="small-muted">Read it as a story. Correct anything that does not sound like you, then approve it in Career Evidence.</p><p><a class="button button-primary" href="/career-evidence/{{.EvidenceID}}">Review saved evidence</a></p></section>
+  {{else if .NeedsLeads}}
+    <section aria-labelledby="leads-retry"><h2 id="leads-retry">Your excerpt is saved</h2><p class="small-muted">Muse has not identified investigation leads yet. Retry sends only the saved excerpt.</p>
+      <form method="POST" action="/career-discovery/{{.ID}}/leads"><input type="hidden" name="revision" value="{{.Revision}}"><label class="confirm-row"><input type="checkbox" name="consent" value="yes" required><span>Send the saved résumé excerpt to {{.Destination}} to identify investigation leads.</span></label><button class="button button-primary" type="submit">Find investigation leads</button></form></section>
+  {{else if .LeadPicker}}
+    <section aria-labelledby="leads-title"><h2 id="leads-title">Where should we investigate?</h2><p class="small-muted">Muse read your excerpt and sees these threads. Each “why” is a hypothesis to test, not a fact about you. Pick one; you can return for the others.</p>
+      <div class="lead-list">{{range .State.Leads}}
+        <article class="lead-card"><h3>{{.Title}}</h3><p>{{.Why}}</p>
+          <form method="POST" action="/career-discovery/{{$.ID}}/select"><input type="hidden" name="revision" value="{{$.Revision}}"><input type="hidden" name="lead_id" value="{{.ID}}"><label class="confirm-row"><input type="checkbox" name="consent" value="yes" required><span>Send my excerpt and this choice to {{$.Destination}} to begin this investigation.</span></label><button class="button button-primary" type="submit">Investigate this</button></form>
+        </article>{{end}}</div></section>
+  {{else}}
+    {{if .State.SelectedLead}}<p class="investigator-focus">Investigating: <strong>{{.State.SelectedLead.Title}}</strong></p>{{end}}
+    {{if .State.Proposal}}<section class="story-card" aria-labelledby="proposal-title"><p class="story-kicker">Proposed career story · needs your review</p><h2 id="proposal-title">{{.State.Proposal.Title}}</h2><p class="story-body">{{.State.Proposal.Experience}}</p><p><strong>What you established:</strong> {{.State.Proposal.Claim}}</p>
+      <details><summary>Inspect supporting source · {{.State.Proposal.SourceID}}</summary><p class="small-muted">Your own words, recorded during this investigation. Self-report; not independently verified.</p><pre class="evidence-text">{{.State.Proposal.Quote}}</pre></details>
+      {{if .State.Proposal.Unresolved}}<h3>Still unresolved</h3><ul>{{range .State.Proposal.Unresolved}}<li>{{.}}</li>{{end}}</ul>{{end}}
+      <form method="POST" action="/career-discovery/{{.ID}}/evidence"><input type="hidden" name="revision" value="{{.Revision}}"><p class="small-muted">This creates an editable draft. Approval requires your confirmation in Career Evidence.</p><button class="button button-primary" type="submit">Create evidence draft for review</button></form>
+    </section>{{end}}
+    {{if .CanAnswer}}<section class="question-card" aria-labelledby="current-question"><p class="story-kicker">Muse asks · one question at a time</p><h2 id="current-question" class="question-text">{{.State.Question}}</h2>
+      <form method="POST" action="/career-discovery/{{.ID}}/next" class="career-evidence-form"><input type="hidden" name="revision" value="{{.Revision}}">
+        <div class="field"><label for="discovery-answer">Your response, in your own words</label><textarea id="discovery-answer" name="answer" rows="6" maxlength="2000" required></textarea><small>Specifics help: what you personally did, how you decided, who else was involved, and what you do not know.</small></div>
+        <label class="confirm-row"><input type="checkbox" name="consent" value="yes" required><span>Send this response, the résumé excerpt, and earlier interview responses to {{.Destination}} for this request.</span></label>
+        <button class="button button-primary" type="submit">Answer and continue</button>
+      </form></section>
+    {{else if not .State.Question}}<form method="POST" action="/career-discovery/{{.ID}}/next"><input type="hidden" name="revision" value="{{.Revision}}"><label class="confirm-row"><input type="checkbox" name="consent" value="yes" required><span>Send the saved interview to {{.Destination}} for another request.</span></label><button class="button button-secondary" type="submit">Retry Muse request</button></form>
+    {{else}}<p>This investigation reached its six-response limit. Review the proposed story above, or explore another lead from the panel.</p>{{end}}
+  {{end}}
+  </div>
+  <aside class="investigator-aside" aria-label="What Muse has learned">
+    <section><h2>What we have learned</h2>
+      {{if .State.Responses}}<ol class="learned-list">{{range .State.Responses}}<li><p class="learned-q">{{.Question}}</p><p>{{.Source.Text}}</p><p class="small-muted">Your statement · {{.Source.ID}} · self-report</p></li>{{end}}</ol>
+      {{else}}<p class="small-muted">Nothing yet. Your answers will appear here as established statements, separate from Muse’s interpretations.</p>{{end}}
+    </section>
+    <section><h2>Still unresolved</h2>
+      {{if and .State.Proposal .State.Proposal.Unresolved}}<ul>{{range .State.Proposal.Unresolved}}<li>{{.}}</li>{{end}}</ul>
+      {{else}}<p class="small-muted">Outcomes and responsibilities stay unknown until you establish them. Muse will not invent them.</p>{{end}}
+    </section>
+    {{if .State.Leads}}<section><h2>Investigation leads</h2><ul class="aside-leads">{{range .State.Leads}}<li>{{if eq .ID $.State.SelectedLeadID}}<strong>{{.Title}}</strong> · investigating{{else}}{{.Title}}{{end}}</li>{{end}}</ul>
+      {{if or .EvidenceID (not .LeadPicker)}}<p class="small-muted">Explore another lead in a fresh investigation. This one stays saved.</p>{{range .State.Leads}}{{if ne .ID $.State.SelectedLeadID}}<form method="POST" action="/career-discovery/{{$.ID}}/explore" class="explore-form"><input type="hidden" name="revision" value="{{$.Revision}}"><input type="hidden" name="lead_id" value="{{.ID}}"><label class="confirm-row"><input type="checkbox" name="consent" value="yes" required><span>Send my excerpt to {{$.Destination}} to investigate “{{.Title}}” .</span></label><button class="button button-secondary" type="submit">Explore: {{.Title}}</button></form>{{end}}{{end}}{{end}}
+    </section>{{end}}
+    <details class="career-evidence-source"><summary>Source record · résumé and statements</summary><h3>Résumé excerpt you provided</h3><pre class="evidence-text">{{.State.Resume.Text}}</pre>{{range .State.Responses}}<h3>Muse asked</h3><p>{{.Question}}</p><p class="small-muted">Candidate self-report · {{.Source.ID}}</p><pre class="evidence-text">{{.Source.Text}}</pre>{{end}}</details>
+    <p><a href="/career-discovery">All investigations / start another</a></p>
+  </aside>
+</div>
+<script>document.addEventListener('DOMContentLoaded',function(){var t=document.getElementById('discovery-answer');if(!t)return;window.addEventListener('beforeunload',function(e){if(t.value.trim()){e.preventDefault();e.returnValue='';}});t.form.addEventListener('submit',function(){t.dataset.submitted='1';window.onbeforeunload=null;});});</script>
+{{else}}
+<div class="investigator-start">
+  <form method="POST" action="/career-discovery" class="career-evidence-form">
+    <div class="field"><label for="discovery-resume">Your résumé bullets</label><textarea id="discovery-resume" name="resume" rows="8" maxlength="8000" placeholder="• Provided Linux and database troubleshooting support.&#10;• Helped customers resolve account and access issues." required></textarea><small>Paste a few ordinary bullets. Muse will identify which experiences are worth investigating. Use synthetic information for public demonstrations.</small></div>
+    <label class="confirm-row"><input type="checkbox" name="consent" value="yes" required><span>Send this excerpt to {{.Destination}} to identify investigation leads. Your interview is saved locally. AI proposals require my review before they represent my experience.</span></label>
+    <button class="button button-primary" type="submit">Find my investigation leads</button>
+  </form>
+  {{if .Sessions}}<h2>Saved investigations</h2><ul>{{range .Sessions}}<li><a href="/career-discovery/{{.ID}}">Investigation {{.ID}}</a> · <time datetime="{{.CreatedAt}}">{{humanDate .CreatedAt}}</time></li>{{end}}</ul>{{end}}
+</div>
+{{end}}
+{{template "shell-close" .}}</body></html>
