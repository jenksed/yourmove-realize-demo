diff --git a/scripts/run-discovery-demo.py b/scripts/run-discovery-demo.py
new file mode 100644
index 0000000..93a0836
--- /dev/null
+++ b/scripts/run-discovery-demo.py
@@ -0,0 +1,34 @@
+#!/usr/bin/env python3
+"""Launch an already built Hackathon binary with an isolated synthetic workspace.
+
+Loads only MODEL_API_KEY from the local ignored .env, without shell evaluation.
+"""
+import os
+from pathlib import Path
+import shlex
+import sys
+
+if len(sys.argv) != 3 or not Path(sys.argv[2]).is_absolute():
+    raise SystemExit("Usage: python3 scripts/run-discovery-demo.py /absolute/binary /absolute/synthetic-workspace")
+env_file = Path(__file__).resolve().parent.parent / ".env"
+if not os.environ.get("MODEL_API_KEY") and env_file.exists():
+    for line in env_file.read_text().splitlines():
+        line = line.strip()
+        if line.startswith("export "):
+            line = line[7:]
+        key, sep, value = line.partition("=")
+        if sep and key.strip() == "MODEL_API_KEY":
+            try:
+                parts = shlex.split(value, comments=True)
+            except ValueError:
+                raise SystemExit("MODEL_API_KEY assignment could not be parsed") from None
+            if len(parts) == 1:
+                os.environ["MODEL_API_KEY"] = parts[0]
+if not os.environ.get("MODEL_API_KEY"):
+    raise SystemExit("Set MODEL_API_KEY in the environment or the ignored .env")
+os.environ["YOURMOVE_DATA_DIR"] = sys.argv[2]
+os.environ.setdefault("YOURMOVE_HTTP_PORT", "3019")
+os.environ["YOURMOVE_COMPAT_URL"] = "https://api.meta.ai/v1/chat/completions"
+os.environ["YOURMOVE_COMPAT_MODEL"] = "muse-spark-1.3"
+os.environ["YOURMOVE_COMPAT_API_KEY"] = os.environ["MODEL_API_KEY"]
+os.execvp(sys.argv[1], [sys.argv[1]])
diff --git a/templates/career_discovery.html b/templates/career_discovery.html
new file mode 100644
index 0000000..05e1d48
--- /dev/null
+++ b/templates/career_discovery.html
@@ -0,0 +1,37 @@
+<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Career Discovery · YourMove</title><link rel="stylesheet" href="/static/styles.css"><script defer src="/static/ui.js"></script></head><body>
+{{template "shell-open" "career-evidence"}}
+<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/career-evidence">Career Evidence</a><span aria-hidden="true">/</span><span>Career Discovery</span></nav>
+<div class="page-heading"><div><h1>Career Discovery</h1><p class="page-description">Explore one experience with Muse. You decide which claims accurately represent you.</p></div></div>
+<div class="career-evidence-editor">
+{{if .ID}}
+  {{if .Notice}}<p class="local-save-confirmation" role="status">{{.Notice}}</p>{{end}}
+  {{if .EvidenceID}}
+    <h2>Your evidence draft is ready for review</h2><p><a class="button button-primary" href="/career-evidence/{{.EvidenceID}}">Review saved evidence</a></p>
+  {{else}}
+    {{if .State.Proposal}}<section aria-labelledby="proposal-title"><h2 id="proposal-title">Proposed experience</h2><h3>{{.State.Proposal.Title}}</h3><p>{{.State.Proposal.Experience}}</p><p><strong>Proposed claim:</strong> {{.State.Proposal.Claim}}</p>
+      <details><summary>Inspect supporting source · {{.State.Proposal.SourceID}}</summary><p class="small-muted">Candidate self-report; not independently verified. The full recorded response appears below.</p><pre class="evidence-text">{{.State.Proposal.Quote}}</pre></details>
+      {{if .State.Proposal.Unresolved}}<h3>Still unresolved</h3><ul>{{range .State.Proposal.Unresolved}}<li>{{.}}</li>{{end}}</ul>{{end}}
+      <form method="POST" action="/career-discovery/{{.ID}}/evidence"><input type="hidden" name="revision" value="{{.Revision}}"><p class="small-muted">This creates an editable draft. Approval requires your confirmation in Career Evidence.</p><button class="button button-primary" type="submit">Create evidence draft for review</button></form>
+    </section>{{end}}
+    {{if .CanAnswer}}<section><h2>Muse asks</h2><p>{{.State.Question}}</p>
+      <form method="POST" action="/career-discovery/{{.ID}}/next" class="career-evidence-form"><input type="hidden" name="revision" value="{{.Revision}}">
+        <div class="field"><label for="discovery-answer">Your response</label><textarea id="discovery-answer" name="answer" rows="5" maxlength="2000" required></textarea></div>
+        <label class="confirm-row"><input type="checkbox" name="consent" value="yes" required><span>Send this response, the résumé excerpt, and earlier interview responses to Meta for this request (muse-spark-1.3, standard mode).</span></label>
+        <button class="button button-secondary" type="submit">Respond and continue</button>
+      </form></section>
+    {{else if not .State.Question}}<form method="POST" action="/career-discovery/{{.ID}}/next"><input type="hidden" name="revision" value="{{.Revision}}"><label class="confirm-row"><input type="checkbox" name="consent" value="yes" required><span>Send the saved interview to Meta for another request.</span></label><button class="button button-secondary" type="submit">Retry Muse request</button></form>
+    {{else}}<p>This interview reached its six-response limit. Review the proposal or begin another interview.</p>{{end}}
+  {{end}}
+  <details class="career-evidence-source"><summary>Recorded résumé and responses</summary><h3>Before discovery · résumé excerpt</h3><pre class="evidence-text">{{.State.Resume.Text}}</pre>{{range .State.Responses}}<h3>Muse asked</h3><p>{{.Question}}</p><p class="small-muted">Candidate self-report · {{.Source.ID}}</p><pre class="evidence-text">{{.Source.Text}}</pre>{{end}}</details>
+  <p><a href="/career-discovery">All interviews / start another</a></p>
+{{else}}
+  <form method="POST" action="/career-discovery" class="career-evidence-form">
+    <div class="field"><label for="discovery-resume">Résumé excerpt to explore</label><textarea id="discovery-resume" name="resume" rows="5" maxlength="8000" placeholder="Provided Linux and database troubleshooting support." required></textarea><small>Paste an excerpt you want to develop. Use synthetic information for public demonstrations.</small></div>
+    <label class="confirm-row"><input type="checkbox" name="consent" value="yes" required><span>Send this excerpt to Meta to begin an interview with muse-spark-1.3 (standard mode). Your interview is saved locally. AI proposals require my review before they represent my experience.</span></label>
+    <button class="button button-primary" type="submit">Begin discovery</button>
+  </form>
+  {{if .Sessions}}<h2>Saved interviews</h2><ul>{{range .Sessions}}<li><a href="/career-discovery/{{.ID}}">Interview {{.ID}}</a> · <time datetime="{{.CreatedAt}}">{{humanDate .CreatedAt}}</time></li>{{end}}</ul>{{end}}
+{{end}}
+</div>
+{{template "shell-close" .}}</body></html>
